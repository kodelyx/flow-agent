{
  "manifest_version": 3,
  "name": "Flow Bridge",
  "version": "1.0.0",
  "description": "Real-time session and cookie synchronizer for Google Flow.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "cookies",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://google.com/*",
    "http://google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Flow Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
